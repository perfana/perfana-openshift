# Browser-facing hostnames (OpenShift Routes, TLS edge-terminated by the router).
# Typically <name>.apps.<cluster-domain>. The API gets its own host: the UI serves its own /api/config.
PERFANA_HOST=perfana.apps.example.com
API_HOST=perfana-api.apps.example.com
KEYCLOAK_HOST=perfana-keycloak.apps.example.com

# Existing Grafana that Perfana reads metrics from (not deployed here). Must be reachable
# from the browser (embedded panels) and from perfana-worker / perfana-grafana-sync.
GRAFANA_URL=https://grafana.example.com

TZ=Europe/Amsterdam

# Outbound proxy for perfana-api / perfana-worker (corporate env). Leave empty if none.
HTTP_PROXY=
HTTPS_PROXY=
NO_PROXY=localhost,127.0.0.1,.svc,.cluster.local,perfana-db-rw,valkey,keycloak,perfana-api
