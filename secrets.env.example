# cp secrets.env.example secrets.env   — secrets.env is git-ignored. Never commit it.
# Generate values:  openssl rand -base64 24   /   openssl rand -hex 32

POSTGRES_PASSWORD=change-me-postgres

# Keycloak master-realm admin
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=change-me-keycloak-admin

# Confidential client secrets in realm perfana-prod. bootstrap.sh writes these into Keycloak.
KEYCLOAK_CLIENT_SECRET=change-me-perfana-api-secret
KEYCLOAK_ADMIN_CLIENT_SECRET=change-me-perfana-admin-secret
GRAFANA_OAUTH_CLIENT_SECRET=change-me-grafana-oauth-secret

# 64 hex chars (openssl rand -hex 32). MUST stay stable: changing it makes stored secrets unreadable.
ENCRYPTION_KEY=change-me-64-hex-characters-0000000000000000000000000000000000

GRAFANA_ADMIN_USER=perfana
GRAFANA_ADMIN_PASSWORD=change-me-grafana-admin

# Used by bootstrap.sh only
PERFANA_ORG_NAME=Perfana
PERFANA_ADMIN_USER=admin@perfana.io
PERFANA_ADMIN_PASSWORD=change-me-perfana-admin-login
